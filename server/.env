APP_NAME=IoT Artifact Server
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=*
ENVIRONMENT=development
DEVICE_API_KEY=CHANGE_ME_DEV_DEVICE_KEY
DEVICE_ENROLLMENT_KEY=CHANGE_ME_DEV_ENROLLMENT_KEY
AUTH_SECRET_KEY=CHANGE_ME_DEV_AUTH_SECRET

DATA_DIR=
MODEL_DIR=
RUN_POSE_ON_UPLOAD=true
RUN_AI_ON_UPLOAD=false
AUTO_DISPATCH_POSE_COMMAND=true
AUTH_DATABASE_URL=postgresql+psycopg://artifact:dev-only-postgres-password@127.0.0.1:5432/artifact_auth

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE_SEC=60
MQTT_USERNAME=CHANGE_ME_DEV_MQTT_USER
MQTT_PASSWORD=CHANGE_ME_DEV_MQTT_PASSWORD
MQTT_QOS=1
MQTT_CMD_TOPIC_TEMPLATE=cmd/{device_id}
MQTT_ACK_TOPIC_TEMPLATE=ack/{device_id}
MQTT_STATUS_TOPIC_TEMPLATE=status/{device_id}

ARTIFACT_POSE_ROOT=
ARTIFACT_CAMERA_PARAMS_DIR=
ARTIFACT_CAMERA_PARAMS=
ARTIFACT_LENS_POSITION=1.5
ARTIFACT_GOLDEN_POSE=

ACK_HISTORY_LIMIT=200
MAX_ALIGNMENT_ITERATIONS=7
ALIGNMENT_TIMEOUT_SEC=300

SIGN_MOVE_X=1
SIGN_MOVE_Z=1
SIGN_ROTATE_PAN=-1
SIGN_ROTATE_TILT=-1

TRANS_TOLERANCE_MM=25.0
ROT_TOLERANCE_DEG=2.0
STEPS_PER_MM=800.0
