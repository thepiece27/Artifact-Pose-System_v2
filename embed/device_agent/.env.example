# Example values only. Copy to .env on the Raspberry Pi and adapt.
# (Existing variables are documented in docs/04_Configuration_and_Scalability.md section 7.)

# --- CITA 2027 I2 motion profile (all optional; unset = old device behaviour) ---
# Priority: motion_profile field of the MQTT command > these variables > defaults.
CITA_MOTION_FLOAT_ANGLES=0
CITA_MOTION_SETTLE_S=0
CITA_MOTION_UNIDIRECTIONAL=0
CITA_MOTION_APPROACH_SIGN=1
CITA_MOTION_BACKLASH_DEG=0
CITA_MOTION_BACKLASH_STEPS=0
CITA_MOTION_SERVO_RELEASE=0
